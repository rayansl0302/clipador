# Desenvolvimento local. Copie para .env se quiser sobrescrever os padrões do docker-compose.
# Estas senhas NÃO servem para produção.

CLIP_ENV=development
POSTGRES_USER=clip
POSTGRES_PASSWORD=clip
POSTGRES_DB=clipstudio
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clip:clip@postgres:5432/clipstudio

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

S3_ACCESS_KEY_ID=clip
S3_SECRET_ACCESS_KEY=clipsecret
S3_BUCKET=clip-studio
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001

API_PORT=8000
WEB_PORT=3000
API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=dev-only-change-me
JWT_TTL_SECONDS=1209600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_SIGNUP=true

MAX_VIDEO_DURATION_SECONDS=7200
MAX_UPLOAD_BYTES=524288000
WORKER_CONCURRENCY=1
CLEANUP_INTERVAL_SECONDS=3600
CLEANUP_MAX_AGE_SECONDS=21600

TRANSCRIBE_PROVIDER=local
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_MAX_BYTES=20000000
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
FASTER_WHISPER_MODEL=base
LOCAL_CHUNK_SECONDS=600

LLM_PROVIDER=heuristic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

POSTIZ_URL=
POSTIZ_API_KEY=
